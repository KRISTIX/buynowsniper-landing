# Telegram bot username without @ — used for all primary CTAs
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=buynowsniperbot

# Support / sales bot username without @ — Contact sales CTAs
NEXT_PUBLIC_TELEGRAM_SUPPORT_USERNAME=buynowsniper_supportbot

# Canonical site URL (SEO / Open Graph)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
